    {
        "id": "n_comando",
        "type": "function",
        "z": "tab_irrigacao",
        "name": "Montar comando",
        "func": "// Monta o comando no formato do IoT Agent (UltraLight): irrig001@<comando>|<valor>\n// O ESP32 assina /TEF/irrig001/cmd e responde em /TEF/irrig001/cmdexe.\nlet cmd, valor;\nif (msg.topic === 'regar') { cmd = 'regar'; valor = flow.get('segundosRega') ?? 5; }\nelse if (msg.topic === 'parar') { cmd = 'regar'; valor = 0; }\nelse if (msg.topic === 'modo') { cmd = 'definirModo'; valor = msg.payload; }\nelse return null;\n\nflow.set('ultimoComandoMs', Date.now());\nflow.set('comandoPendente', { cmd, ms: Date.now() });\n\nconst texto = cmd === 'regar' ? (valor ? 'Regar ' + valor + ' s' : 'Parar') : 'Modo ' + (valor === 'A' ? 'AUTO' : 'MANUAL');\nreturn [\n    { topic: '/TEF/irrig001/cmd', payload: 'irrig001@' + cmd + '|' + valor },\n    { payload: texto + ': enviado, aguardando o dispositivo...' }\n];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 760,
        "y": 760,
        "outputLabels": [
            "/TEF/irrig001/cmd",
            "texto de espera"
        ],
        "wires": [
            [
                "n_simulador",
                "n_mqtt_cmd"
            ],
            [
                "w_resposta"
            ]
        ],
        "g": "grp_controle"
