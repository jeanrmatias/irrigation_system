    {
        "id": "n_simulador",
        "type": "function",
        "z": "tab_irrigacao",
        "name": "Simulador Arduino + ESP32",
        "func": "// Simula o Arduino UNO + ESP32, com as mesmas regras do firmware\n// (Arduino/src/config.h e Arduino/src/irrigacao/irrigacao.cpp).\n//\n// Entradas (msg.topic):\n//   \"tick\"               a cada 1 s: avança a \"física\" e decide a rega\n//   \"/TEF/irrig001/cmd\"  comando vindo do dashboard (irrig001@regar|5)\n//   \"sim/<chave>\"        painel \"Simulação\" (liga/desliga Arduino, falhas...)\n// Saída 1: o que o ESP32 publicaria em /TEF/irrig001/attrs  (UltraLight 2.0)\n// Saída 2: o que o ESP32 publicaria em /TEF/irrig001/cmdexe (resposta do comando)\n\nconst SOLO_SECO = 100, SOLO_MEDIO = 300, UMIDADE_AR_BAIXA = 30;\nconst REGA_PADRAO_S = 3, REGA_MAX_S = 30;\nconst INTERVALO_MIN_REGAS_MS = 30000, INTERVALO_ENVIO_MS = 2000;\nconst TIMEOUT_ARDUINO_MS = 6000, REENVIO_LINK_MS = 10000;\n\nconst agora = Date.now();\nconst s = context.get('s') || {\n    solo: 170, umidAr: 50, temp: 24, modo: 'A',\n    valvulaAteMs: 0, ultimaRegaMs: 0, jaRegou: false,\n    falhaDht: false, falhaSolo: false,\n    arduinoLigado: true, esp32Ligado: true,\n    arduinoOnline: true, ultimoQuadroMs: agora,\n    ultimoEnvioMs: 0, ultimoLinkMs: 0, inicioMs: agora\n};\nconst valvulaAberta = () => agora < s.valvulaAteMs;\nfunction abrir(segundos) {\n    s.valvulaAteMs = agora + segundos * 1000;\n    s.ultimaRegaMs = agora;\n    s.jaRegou = true;\n}\n\nlet attrs = null, cmdexe = null;\nconst topico = msg.topic || '';\n\nif (topico.startsWith('sim/')) {\n    // Painel de simulação\n    const chave = topico.slice(4);\n    if (chave === 'secar') s.solo = 60;\n    else if (chave in s) s[chave] = !!msg.payload;\n\n} else if (topico.endsWith('/cmd')) {\n    // Comando da nuvem: o ESP32 repassa ao Arduino e devolve a resposta\n    if (!s.esp32Ligado) { context.set('s', s); return null; }  // ninguém ouvindo\n    const [cmd, valor] = (String(msg.payload).split('@')[1] || '').split('|');\n    let res;\n    if (!s.arduinoOnline) res = 'ARDUINO_OFFLINE';\n    else if (cmd === 'regar') {\n        const n = Number(valor);\n        if (!Number.isInteger(n) || n < 0 || n > REGA_MAX_S) res = 'ERRO_VALOR';\n        else { if (n === 0) s.valvulaAteMs = 0; else abrir(n); res = 'OK'; }\n    } else if (cmd === 'definirModo') {\n        if (valor === 'A' || valor === 'M') { s.modo = valor; res = 'OK'; }\n        else res = 'ERRO_VALOR';\n    } else res = 'ERRO';\n    cmdexe = { topic: '/TEF/irrig001/cmdexe', payload: 'irrig001@' + cmd + '|' + res };\n\n} else {\n    // tick: 1 segundo de \"física\"\n    const t = (agora - s.inicioMs) / 1000;\n    const ruido = (a) => (Math.random() - 0.5) * 2 * a;\n    s.temp = 25 + 5 * Math.sin(t / 240) + ruido(0.2);\n    s.umidAr = 45 + 20 * Math.sin(t / 300 + 2) + ruido(0.5);\n\n    if (!s.arduinoLigado) s.valvulaAteMs = 0;          // sem Arduino o servo não abre\n    if (valvulaAberta()) s.solo += 45 + ruido(5);     // regando: o solo molha rápido\n    else s.solo -= 1.5 + Math.max(0, s.temp - 20) * 0.12 + ruido(0.6);  // evaporação\n    s.solo = Math.min(900, Math.max(20, s.solo));\n\n    // Mesma decisão de irrigacaoPrecisaRegar()\n    if (s.arduinoLigado && s.modo === 'A' && !valvulaAberta() && !s.falhaSolo &&\n        !(s.jaRegou && agora - s.ultimaRegaMs < INTERVALO_MIN_REGAS_MS)) {\n        const soloSeco = s.solo < SOLO_SECO;\n        const arSeco = !s.falhaDht && s.umidAr < UMIDADE_AR_BAIXA && s.solo < SOLO_MEDIO;\n        if (soloSeco || arSeco) abrir(REGA_PADRAO_S);\n    }\n\n    // Lado do ESP32: vigia o Arduino e publica no MQTT\n    if (s.arduinoLigado) s.ultimoQuadroMs = agora;     // o Arduino manda $D a cada 2 s\n    const estavaOnline = s.arduinoOnline;\n    s.arduinoOnline = agora - s.ultimoQuadroMs <= TIMEOUT_ARDUINO_MS;\n\n    if (s.esp32Ligado) {\n        if (s.arduinoLigado && s.arduinoOnline && agora - s.ultimoEnvioMs >= INTERVALO_ENVIO_MS) {\n            s.ultimoEnvioMs = agora;\n            let ul = '';\n            if (!s.falhaSolo) ul += 's|' + Math.round(s.solo) + '|';\n            if (!s.falhaDht) ul += 'u|' + s.umidAr.toFixed(1) + '|t|' + s.temp.toFixed(1) + '|';\n            const erros = (s.falhaDht ? 1 : 0) | (s.falhaSolo ? 2 : 0);\n            ul += 'v|' + (valvulaAberta() ? 1 : 0) + '|m|' + s.modo + '|e|' + erros + '|l|1';\n            attrs = { topic: '/TEF/irrig001/attrs', payload: ul };\n        } else if (!s.arduinoOnline && (estavaOnline || agora - s.ultimoLinkMs >= REENVIO_LINK_MS)) {\n            s.ultimoLinkMs = agora;\n            attrs = { topic: '/TEF/irrig001/attrs', payload: 'l|0' };\n        }\n    }\n}\n\ncontext.set('s', s);\nnode.status(!s.esp32Ligado ? { fill: 'grey', shape: 'ring', text: 'ESP32 desligado' }\n    : !s.arduinoOnline ? { fill: 'red', shape: 'ring', text: 'Arduino offline' }\n    : { fill: valvulaAberta() ? 'blue' : 'green', shape: 'dot',\n        text: 'solo ' + Math.round(s.solo) + ' | ' + (s.modo === 'A' ? 'AUTO' : 'MANUAL') + (valvulaAberta() ? ' | regando' : '') });\nreturn [attrs, cmdexe];\n",
        "outputs": 2,
