    {
        "id": "n_decodificador",
        "type": "function",
        "z": "tab_irrigacao",
        "name": "Decodificar UltraLight",
        "func": "// Lê o que o ESP32 publica no FIWARE (UltraLight 2.0) e prepara cada widget.\n// Funciona do mesmo jeito com o simulador ou com o MQTT de verdade.\n//\n// Saídas: 1 gauge solo | 2 nível do solo | 3 gauge umidade do ar | 4 gauge temperatura\n//         5 estado do sistema | 6 chave do modo | 7 gráfico do solo | 8 gráfico do ar\n//         9 notificações | 10 resposta do comando\n\nconst SOLO_SECO = 100, SOLO_MEDIO = 300, SOLO_ALTO = 500;\nconst SEM_DADOS_MS = 15000, SEM_RESPOSTA_MS = 6000;\n\nconst agora = Date.now();\nconst e = flow.get('estado') || {\n    solo: null, umidAr: null, temp: null, valvula: 0, modo: 'A', erros: 0,\n    arduinoOnline: null, ultimoDadoMs: 0, regas: 0, ultimaRega: null, avisosAtivos: []\n};\nconst out = new Array(10).fill(null);\nconst topico = msg.topic || '';\n\nconst hora = (ms) => new Date(ms).toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nfunction nivelSolo(v) {\n    if (v == null) return '—';\n    if (v < SOLO_SECO) return 'SECO';\n    if (v < SOLO_MEDIO) return 'BAIXO';\n    if (v < SOLO_ALTO) return 'MÉDIO';\n    return 'ALTO';\n}\nconst NOMES = { regar: 'Regar', definirModo: 'Trocar modo' };\nconst notificacoes = [];\n\nif (topico.endsWith('/cmdexe')) {\n    // \"irrig001@regar|OK\"\n    const [cmd, res] = (String(msg.payload).split('@')[1] || '').split('|');\n    flow.set('comandoPendente', null);\n    out[9] = { payload: (NOMES[cmd] || cmd) + ': ' + res + ' (' + hora(agora) + ')' };\n    if (res !== 'OK') notificacoes.push('Comando \"' + (NOMES[cmd] || cmd) + '\" falhou: ' + res);\n\n} else if (topico.endsWith('/attrs')) {\n    // \"s|350|u|55.3|t|24.3|v|0|m|A|e|0|l|1\"  (ou só \"l|0\" quando o Arduino cai)\n    const partes = String(msg.payload).split('|');\n    const d = {};\n    for (let i = 0; i + 1 < partes.length; i += 2) d[partes[i]] = partes[i + 1];\n\n    if ('l' in d) e.arduinoOnline = d.l === '1';\n    if ('v' in d) {\n        const valvulaAntes = e.valvula;\n        e.solo = 's' in d ? parseInt(d.s, 10) : null;           // não vem se o sensor falhar\n        e.umidAr = 'u' in d ? parseFloat(d.u) : null;           // não vem se o DHT11 falhar\n        e.temp = 't' in d ? parseFloat(d.t) : null;\n        e.valvula = parseInt(d.v, 10) || 0;\n        e.modo = d.m || e.modo;\n        e.erros = parseInt(d.e, 10) || 0;\n        e.ultimoDadoMs = agora;\n\n        if (e.valvula === 1 && valvulaAntes !== 1) {\n            e.regas++;\n            const peloPainel = agora - (flow.get('ultimoComandoMs') || 0) < 5000;\n            const origem = peloPainel ? 'pelo dashboard' : (e.modo === 'A' ? 'automática' : 'botão no vaso');\n            e.ultimaRega = hora(agora) + ' (' + origem + ')';\n            if (!peloPainel && e.modo === 'A') notificacoes.push('Rega automática iniciada (solo ' + nivelSolo(e.solo) + ')');\n        }\n\n        if (e.solo != null) {\n            out[0] = { payload: e.solo };\n            out[1] = { payload: nivelSolo(e.solo) + '  (' + e.solo + ')' };\n            out[6] = [\n                { topic: 'Solo', payload: e.solo },\n                { topic: 'Seco (100)', payload: SOLO_SECO },\n                { topic: 'Médio (300)', payload: SOLO_MEDIO }\n            ];\n        } else {\n            out[1] = { payload: 'ERRO NO SENSOR' };\n        }\n        if (e.umidAr != null) {\n            out[2] = { payload: e.umidAr };\n            out[3] = { payload: e.temp };\n            out[7] = [\n                { topic: 'Umidade do ar (%)', payload: e.umidAr },\n                { topic: 'Temperatura (°C)', payload: e.temp }\n            ];\n        }\n        out[5] = { payload: e.modo };\n    }\n}\n\n// Comando sem resposta (ESP32 desligado ou sem internet)\nconst pendente = flow.get('comandoPendente');\nif (pendente && agora - pendente.ms > SEM_RESPOSTA_MS) {\n    flow.set('comandoPendente', null);\n    out[9] = { payload: (NOMES[pendente.cmd] || pendente.cmd) + ': SEM_RESPOSTA (' + hora(agora) + ')' };\n    notificacoes.push('O dispositivo não respondeu ao comando');\n}\n\n// Avisos (mesmas regras do dashboard em Python)\nconst semDadosMs = e.ultimoDadoMs ? agora - e.ultimoDadoMs : Infinity;\nconst avisos = [];\nif (e.arduinoOnline === false) avisos.push({ id: 'offline', nivel: 'ruim', texto: 'Arduino offline: o ESP32 não recebe dados dele' });\nelse if (semDadosMs > SEM_DADOS_MS) avisos.push({ id: 'semdados', nivel: 'atencao',\n    texto: e.ultimoDadoMs ? 'Sem dados novos há ' + Math.round(semDadosMs / 1000) + ' s (ESP32 ou internet fora?)' : 'Aguardando os primeiros dados...' });\nif (e.erros & 2) avisos.push({ id: 'solo', nivel: 'ruim', texto: 'Sensor de solo desconectado: rega automática suspensa' });\nif (e.erros & 1) avisos.push({ id: 'dht', nivel: 'atencao', texto: 'Falha no DHT11 (umidade e temperatura do ar)' });\n\n// Notifica só quando um aviso aparece (não a cada 2 s)\nfor (const a of avisos) if (!e.avisosAtivos.includes(a.id) && e.ultimoDadoMs) notificacoes.push(a.texto);\nfor (const id of e.avisosAtivos) if (!avisos.some(a => a.id === id) && id === 'offline') notificacoes.push('Arduino voltou a se comunicar');\ne.avisosAtivos = avisos.map(a => a.id);\nif (notificacoes.length) out[8] = { payload: notificacoes.join(' | ') };\n\nconst online = e.arduinoOnline !== false && semDadosMs <= SEM_DADOS_MS;\nconst textoErros = ['OK', 'Falha no DHT11', 'Solo desconectado', 'DHT11 e solo com falha'][e.erros & 3];\nout[4] = { payload: {\n    avisos,\n    linhas: [\n        { rotulo: 'Válvula', valor: e.valvula ? 'ABERTA, regando' : 'Fechada', classe: e.valvula ? 'agua' : '' },\n        { rotulo: 'Modo', valor: e.modo === 'A' ? 'AUTO' : 'MANUAL', classe: '' },\n        { rotulo: 'Arduino e ESP32', valor: e.arduinoOnline === false ? 'Offline' : (e.arduinoOnline ? 'Online' : '—'), classe: e.arduinoOnline === false ? 'ruim' : 'bom' },\n        { rotulo: 'Sensores', valor: textoErros, classe: e.erros ? 'ruim' : 'bom' },\n        { rotulo: 'Último dado', valor: e.ultimoDadoMs ? hora(e.ultimoDadoMs) : '—', classe: online ? '' : 'atencao' },\n        { rotulo: 'Regas desde que abriu', valor: String(e.regas), classe: '' },\n        { rotulo: 'Última rega', valor: e.ultimaRega || '—', classe: '' }\n    ]\n} };\n\nflow.set('estado', e);\nreturn out;\n",
        "outputs": 10,
