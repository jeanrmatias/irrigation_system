    {
        "id": "w_estado",
        "type": "ui-template",
        "z": "tab_irrigacao",
        "group": "g_estado",
        "page": "",
        "ui": "",
        "name": "Estado do sistema",
        "order": 1,
        "width": 3,
        "height": 0,
        "head": "",
        "format": "<template>\n  <div class=\"irr-estado\" v-if=\"msg && msg.payload\">\n    <div v-for=\"a in msg.payload.avisos\" :key=\"a.id\" :class=\"['irr-aviso', a.nivel]\">\n      <v-icon size=\"small\">mdi-alert</v-icon> {{ a.texto }}\n    </div>\n    <div v-if=\"!msg.payload.avisos.length\" class=\"irr-aviso tudo-ok\">\n      <v-icon size=\"small\">mdi-check-circle</v-icon> Tudo certo\n    </div>\n    <div v-for=\"l in msg.payload.linhas\" :key=\"l.rotulo\" class=\"irr-linha\">\n      <span>{{ l.rotulo }}</span><b :class=\"l.classe\">{{ l.valor }}</b>\n    </div>\n  </div>\n  <div v-else class=\"irr-vazio\">Aguardando dados...</div>\n</template>\n\n<style>\n.irr-estado { display: flex; flex-direction: column; gap: 6px; width: 100%; }\n.irr-aviso { border-radius: 6px; padding: 8px 10px; font-size: 0.9rem; font-weight: 500; }\n.irr-aviso.ruim { background: #fdecea; color: #b71c1c; }\n.irr-aviso.atencao { background: #fff4e0; color: #8a4b00; }\n.irr-aviso.tudo-ok { background: #e8f5e9; color: #1b5e20; }\n.irr-linha { display: flex; justify-content: space-between; gap: 8px; padding: 4px 0; border-bottom: 1px solid #eef1ec; font-size: 0.95rem; }\n.irr-linha span { color: #5f6b5c; }\n.irr-linha b.bom { color: #2e7d32; }\n.irr-linha b.ruim { color: #c62828; }\n.irr-linha b.atencao { color: #b26a00; }\n.irr-linha b.agua { color: #1565c0; }\n.irr-vazio { color: #888; padding: 8px 0; }\n</style>",
        "storeOutMessages": true,
        "passthru": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "wires": [
            []
        ],
        "x": 1420,
        "y": 280,
        "g": "grp_dashboard"
    },
